    input:
        "results/{sample}/sample.fq"
    output:
        "results/{sample}/stats/{sample}.post_filter.tsv"
    shell:
        "{TOOL_PYTHON} {SCRIPT_FASTQ_STATS} stats --sample {wildcards.sample} --input {input} --output {output}"


rule post_filter_summary:
    input:
        expand("results/{sample}/stats/{sample}.post_filter.tsv", sample=SAMPLES)
    output:
        summary="results/stats/post_filter_summary.sorted.tsv",
        cutoff="results/stats/head_base_cutoff.txt",
        candidates="results/stats/head_cutoff_candidates.tsv"
    params:
        percentile=sample_percentile,
        candidates=candidate_percentiles
    shell:
        "{TOOL_PYTHON} {SCRIPT_SUMMARIZE_STATS} "
        "--percentile {params.percentile} "
        "--candidate-percentiles {params.candidates:q} "
        "--summary {output.summary} "
        "--cutoff {output.cutoff} "
        "--candidates {output.candidates} "
        "{input}"


rule head_by_bases:
    input:
        fq="results/{sample}/sample.fq",
        cutoff="results/stats/head_base_cutoff.txt"
    output:
        fq="results/{sample}/nDNAOK/{sample}.fq",
        stats="results/{sample}/stats/{sample}.head.tsv"
    shell:
        """
        {TOOL_PYTHON} {SCRIPT_FASTQ_STATS} sample \
            --sample {wildcards.sample} \
            --input {input.fq} \
            --cutoff {input.cutoff} \
            --output {output.fq} \
            --stats {output.stats}
        """


rule head_summary:
    input:
        expand("results/{sample}/stats/{sample}.head.tsv", sample=SAMPLES)
    output:
        "results/stats/head_summary.sorted.tsv"
    shell:
        "{TOOL_PYTHON} {SCRIPT_SUMMARIZE_STATS} --summary {output} {input}"


rule prepare_skmer_input_dir:
    input:
        expand("results/{sample}/nDNAOK/{sample}.fq", sample=SAMPLES)
    output:
        directory("results/skmer_input_dir")
    run:
        os.makedirs(output[0], exist_ok=True)
        for f in input:
            dest = os.path.join(output[0], os.path.basename(f))
            if os.path.lexists(dest):
                os.remove(dest)
            try:
                os.symlink(os.path.abspath(f), dest)
            except OSError:
                try:
                    os.link(os.path.abspath(f), dest)
                except OSError:
                    shutil.copyfile(f, dest)


rule skmer_reference:
    input:
        skmer_dir="results/skmer_input_dir"
    output:
        temp("results/skmer/dimtrx_main.txt.txt")
    params:
        prefix="results/skmer/dimtrx_main.txt"
    threads: 16
    shell:
        "mkdir -p results/skmer && {TOOL_SKMER} reference {input.skmer_dir} -s 100000 -S 42 -p {threads} -t -o {params.prefix}"



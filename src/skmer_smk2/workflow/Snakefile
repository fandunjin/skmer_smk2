import glob
import os
import re
import shlex
import shutil


rep_n = int(config.get("rep_n", 100))
input_dir = os.path.abspath(config.get("input_dir", "."))
ref_path = config.get("ref", "")
sample_percentile = float(config.get("sample_percentile", 75))
candidate_percentiles = str(config.get("candidate_percentiles", "50,60,70,75,80,90,95"))
analysis_tokens = [
    token.lower()
    for token in re.split(r"[,\s]+", str(config.get("analyses", "skmer,waster,mash")).strip())
    if token
]
selected_analyses = set(analysis_tokens) or {"skmer", "waster", "mash"}
valid_analyses = {"skmer", "waster", "mash"}
invalid_analyses = selected_analyses - valid_analyses
if invalid_analyses:
    raise ValueError("Invalid analyses selected: {}. Valid choices: skmer,waster,mash".format(
        ",".join(sorted(invalid_analyses))
    ))
exclude_samples = set(
    sample for sample in re.split(r"[,\s]+", str(config.get("exclude_samples", "")).strip()) if sample
)

FASTQ_EXTS = (".fq.gz", ".fastq.gz", ".fq", ".fastq")
PAIR_RE = re.compile(r"^(?P<sample>.+?)(?P<sep>[_.-])(?P<mate>R?[12]|r?[12])$")


def split_fastq_ext(path):
    name = os.path.basename(path)
    for ext in FASTQ_EXTS:
        if name.endswith(ext):
            return name[:-len(ext)], ext
    stem, ext = os.path.splitext(name)
    return stem, ext


def strip_fastq_ext(path):
    return split_fastq_ext(path)[0]


def discover_samples():
    pairs = {}
    for path in glob.glob(os.path.join(input_dir, "*")):
        if not path.endswith(FASTQ_EXTS):
            continue
        stem, ext = split_fastq_ext(path)
        match = PAIR_RE.match(stem)
        if not match:
            continue
        sample = match.group("sample")
        mate = match.group("mate").upper()
        if mate in ("1", "R1"):
            pairs.setdefault(sample, {})["r1"] = os.path.abspath(path)
        elif mate in ("2", "R2"):
            pairs.setdefault(sample, {})["r2"] = os.path.abspath(path)
    complete = {}
    for sample, pair in pairs.items():
        if "r1" in pair and "r2" in pair:
            complete[sample] = pair
    return dict(sorted((sample, pair) for sample, pair in complete.items() if sample not in exclude_samples))


def input_fastq_preview(limit=20):
    if not os.path.isdir(input_dir):
        return "input_dir does not exist or is not a directory"
    files = sorted(
        os.path.basename(path)
        for path in glob.glob(os.path.join(input_dir, "*"))
        if path.endswith(FASTQ_EXTS)
    )
    if not files:
        return "no FASTQ files found in input_dir"
    preview = files[:limit]
    if len(files) > limit:
        preview.append("... ({} more)".format(len(files) - limit))
    return ", ".join(preview)


PAIRS = discover_samples()
SAMPLES = list(PAIRS)
USE_REF = bool(ref_path)
SAMPLE_ARGS = " ".join(shlex.quote(sample) for sample in SAMPLES)
TOOL_PYTHON = shlex.quote(str(config.get("tool_python", "python")))
TOOL_FASTP = shlex.quote(str(config.get("tool_fastp", "fastp")))
TOOL_BOWTIE2 = shlex.quote(str(config.get("tool_bowtie2", "bowtie2")))
TOOL_BOWTIE2_BUILD = shlex.quote(str(config.get("tool_bowtie2_build", "bowtie2-build")))
TOOL_REPAIR = shlex.quote(str(config.get("tool_repair", "repair.sh")))
TOOL_BBMERGE = shlex.quote(str(config.get("tool_bbmerge", "bbmerge.sh")))
TOOL_SKMER = shlex.quote(str(config.get("tool_skmer", "skmer")))
TOOL_FASTME = shlex.quote(str(config.get("tool_fastme", "fastme")))
TOOL_RAXML = shlex.quote(str(config.get("tool_raxml", "raxmlHPC")))
TOOL_WASTER = shlex.quote(str(config.get("tool_waster", "waster")))
TOOL_MASH = shlex.quote(str(config.get("tool_mash", "mash")))
SCRIPT_DIR = os.path.join(workflow.basedir, "scripts")
SCRIPT_FASTQ_STATS = shlex.quote(os.path.join(SCRIPT_DIR, "fastq_stats_and_sample.py"))
SCRIPT_SUMMARIZE_STATS = shlex.quote(os.path.join(SCRIPT_DIR, "summarize_fastq_stats.py"))
SCRIPT_DISTANCE_TO_PHYLIP = shlex.quote(os.path.join(SCRIPT_DIR, "distance_to_phylip.py"))
SCRIPT_MERGE_CONSENSUS = shlex.quote(os.path.join(SCRIPT_DIR, "merge_consensus.py"))
SCRIPT_WRITE_SAMPLE_FASTQ_LIST = shlex.quote(os.path.join(SCRIPT_DIR, "write_sample_fastq_list.py"))
SCRIPT_MASH_DIST_TO_PHYLIP = shlex.quote(os.path.join(SCRIPT_DIR, "mash_dist_to_phylip.py"))
SCRIPT_PLOT_MASH_HEATMAP = shlex.quote(os.path.join(SCRIPT_DIR, "plot_mash_heatmap.py"))

if not SAMPLES:
    raise ValueError(
        "No paired FASTQ files found in input_dir={}. Expected paired names like "
        "sample_1.fq.gz/sample_2.fq.gz, sample_R1.fq.gz/sample_R2.fq.gz, "
        "sample.R1.fq.gz/sample.R2.fq.gz, or sample-R1.fq.gz/sample-R2.fq.gz. "
        "FASTQ preview: {}".format(input_dir, input_fastq_preview())
    )


def raw_r1(wildcards):
    return PAIRS[wildcards.sample]["r1"]


def raw_r2(wildcards):
    return PAIRS[wildcards.sample]["r2"]


def bbmerge_r1(wildcards):
    if USE_REF:
        return "results/{sample}/nDNA/un-conc-mate.1.fixed.fq.gz".format(sample=wildcards.sample)
    return "results/{sample}/clean/{sample}.R1.clean.fq.gz".format(sample=wildcards.sample)


def bbmerge_r2(wildcards):
    if USE_REF:
        return "results/{sample}/nDNA/un-conc-mate.2.fixed.fq.gz".format(sample=wildcards.sample)
    return "results/{sample}/clean/{sample}.R2.clean.fq.gz".format(sample=wildcards.sample)


def bowtie_index_files():
    return expand("results/ref/refDNA.{ext}", ext=["1.bt2", "2.bt2", "3.bt2", "4.bt2", "rev.1.bt2", "rev.2.bt2"])


COMMON_OUTPUTS = [
    "results/stats/post_filter_summary.sorted.tsv",
    "results/stats/head_cutoff_candidates.tsv",
    "results/stats/head_summary.sorted.tsv",
] + expand("results/{sample}/nDNAOK/{sample}.fq", sample=SAMPLES)

ANALYSIS_OUTPUTS = {
    "skmer": [
        "results/skmer/tree.direct.tre",
        "results/skmer/tree.bootstrap.tre",
        "results/skmer/tree.merged.tre",
    ],
    "waster": [
        "results/waster/waster.tree",
    ],
    "mash": [
        "results/mash/tree.direct.tre",
        "results/mash/tree.bootstrap.tre",
        "results/mash/tree.merged.tre",
        "results/mash/distance_heatmap.svg",
    ],
}

FINAL_OUTPUTS = list(COMMON_OUTPUTS)
for analysis in ("skmer", "waster", "mash"):
    if analysis in selected_analyses:
        FINAL_OUTPUTS.extend(ANALYSIS_OUTPUTS[analysis])


rule all:
    input:
        FINAL_OUTPUTS


rule fastp:
    input:
        r1=raw_r1,
        r2=raw_r2
    output:
        r1="results/{sample}/clean/{sample}.R1.clean.fq.gz",
        r2="results/{sample}/clean/{sample}.R2.clean.fq.gz",
        json="results/{sample}/clean/{sample}.fastp.json",
        html="results/{sample}/clean/{sample}.fastp.html"
    log:
        "results/{sample}/clean/{sample}.fastp.log"
    threads: 8
    shell:
        """
        mkdir -p results/{wildcards.sample}/clean
        {TOOL_FASTP} -i {input.r1} -I {input.r2} \
              -o {output.r1} -O {output.r2} \
              -l 100 \
              -q 20 -u 5 \
              --detect_adapter_for_pe \
              --correction \
              -w {threads} \
              -j {output.json} -h {output.html} \
              > {log} 2>&1 || (echo "fastp failed for sample {wildcards.sample}; see {log}" >&2; tail -n 80 {log} >&2; exit 1)
        """


rule bowtie2_build:
    input:
        ref=lambda wildcards: os.path.abspath(ref_path)
    output:
        bowtie_index_files()
    params:
        prefix="results/ref/refDNA"
    shell:
        "mkdir -p results/ref && {TOOL_BOWTIE2_BUILD} {input.ref} {params.prefix}"


rule bowtie2_filter:
    input:
        ref=bowtie_index_files(),
        r1="results/{sample}/clean/{sample}.R1.clean.fq.gz",
        r2="results/{sample}/clean/{sample}.R2.clean.fq.gz"
    output:
        r1="results/{sample}/nDNA/un-conc-mate.1.fq.gz",
        r2="results/{sample}/nDNA/un-conc-mate.2.fq.gz",
        sam="results/{sample}/nDNA/{sample}.sam"
    threads: 48
    shell:
        """
        mkdir -p results/{wildcards.sample}/nDNA
        {TOOL_BOWTIE2} -x results/ref/refDNA \
                -1 {input.r1} -2 {input.r2} \
                --un-conc-gz results/{wildcards.sample}/nDNA/un-conc-mate.%.fq.gz \
                -S {output.sam} -p {threads}
        """


rule repair_pairs:
    input:
        r1="results/{sample}/nDNA/un-conc-mate.1.fq.gz",
        r2="results/{sample}/nDNA/un-conc-mate.2.fq.gz"
    output:
        r1="results/{sample}/nDNA/un-conc-mate.1.fixed.fq.gz",
        r2="results/{sample}/nDNA/un-conc-mate.2.fixed.fq.gz",
        single="results/{sample}/nDNA/singletons.fq.gz"
    threads: 4
    shell:
        """
        {TOOL_REPAIR} in1={input.r1} in2={input.r2} \
                  out1={output.r1} out2={output.r2} outs={output.single} \
                  -Xmx4g threads={threads}
        """


rule bbmerge:
    input:
        r1=bbmerge_r1,
        r2=bbmerge_r2
    output:
        merged="results/{sample}/sample_merged.fq",
        unmerged1="results/{sample}/sample_unmerged1.fq",
        unmerged2="results/{sample}/sample_unmerged2.fq"
    threads: 4
    shell:
        "mkdir -p results/{wildcards.sample} && {TOOL_BBMERGE} t={threads} in1={input.r1} in2={input.r2} out={output.merged} outu1={output.unmerged1} outu2={output.unmerged2}"


rule concatenate_reads:
    input:
        "results/{sample}/sample_merged.fq",
        "results/{sample}/sample_unmerged1.fq",
        "results/{sample}/sample_unmerged2.fq"
    output:
        "results/{sample}/sample.fq"
    shell:
        "cat {input} > {output}"


